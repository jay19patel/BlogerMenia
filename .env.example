# Copy to .env for docker-compose:  cp .env.example .env

# Django settings module (used by manage.py and Celery)
DJANGO_SETTINGS_MODULE=blogermenia.settings

# --- Celery / Redis ---
# "redis" is the service name inside the compose network.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Ollama (runs on the HOST, not in a container) ---
# host.docker.internal resolves to the host machine from inside containers.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
