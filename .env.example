# Copy to .env for docker-compose:  cp .env.example .env

# Django settings module (used by manage.py and Celery)
DJANGO_SETTINGS_MODULE=blogermenia.settings

# --- Django core (leave DEBUG=True for local dev; set False in production) ---
# Generate a fresh key for production:  python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
# Only used when DJANGO_DEBUG=False:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Celery / Redis ---
# "redis" is the service name inside the compose network.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Ollama (runs on the HOST, not in a container) ---
# host.docker.internal resolves to the host machine from inside containers.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
