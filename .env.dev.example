# Copy to .env.dev, fill in your own GOOGLE_API_KEY, then: docker compose up --build
#   cp .env.dev.example .env.dev

DJANGO_SETTINGS_MODULE=blogermenia.settings

# --- Celery / Redis ---
# "redis" is the service name on the compose network — every container resolves
# it automatically, no manual host/IP config needed.
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# --- Google Gemini (embeddings + text generation) ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-3.5-flash
