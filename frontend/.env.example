# Copy to `.env.local` (gitignored) and adjust.

# Root of the DRF API, including the version prefix.
API_BASE_URL=http://localhost:8000/api/v1

# Where Django itself is reachable, for the /accounts/ OAuth passthrough in
# next.config.ts. Defaults to API_BASE_URL's origin.
#
# Use the same hostname the browser uses for this app — `localhost`, not
# `127.0.0.1`. Django builds the OAuth `redirect_uri` from the Host it is
# reached on, so LinkedIn sends the browser straight back to this origin,
# outside the proxy. Cookies ignore the port but not the host, so `localhost`
# keeps allauth's `state` cookie readable at the callback while `127.0.0.1`
# drops it and the login fails.
DJANGO_ORIGIN=http://localhost:8000

# Abort a request to the API after this long.
API_TIMEOUT_MS=10000

# Canonical site origin, used for absolute URLs in metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
