# Copy to .env.prod and fill in real values — never commit .env.prod itself.
#   cp .env.prod.example .env.prod

DJANGO_SETTINGS_MODULE=blogermenia.settings

# --- Django core ---
# Generate a fresh key: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# Flip to True only once nginx (or a load balancer in front of it) terminates TLS.
DJANGO_SECURE_SSL_REDIRECT=False

# --- Postgres ---
# Local Docker Compose uses separate vars; Render automatically provides DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_DB=blogermenia
POSTGRES_USER=blogermenia
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Celery / Redis ---
# Render provides REDIS_URL for internal/external Redis connections
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# --- Google Gemini (embeddings + text generation) ---
GOOGLE_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-3.5-flash
