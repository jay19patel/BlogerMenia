# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Which settings module loads: `dev` (default) or `prod`.
# config/settings/prod.py refuses to start if any required value is missing,
# so a misconfigured deploy fails at boot rather than silently running insecure.
DJANGO_ENV=dev

# --- required in prod -----------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.com

# Where the Next.js app is served. Used to build the public URL of a post for
# LinkedIn shares — Django serves no blog pages itself.
FRONTEND_URL=http://localhost:3000

# --- optional -------------------------------------------------------------
# The browser talks only to the Next.js server, which calls this API from its
# own backend, so this is normally empty in production.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave off until TLS actually terminates in front of nginx — enabling it over
# plain HTTP puts every request in a redirect loop.
DJANGO_SECURE_SSL_REDIRECT=True

# --- Gemini ---------------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- data stores ----------------------------------------------------------
# Leave unset for the defaults: backend/db.sqlite3 and backend/search/milvus.db.
# SQLITE_PATH=
# MILVUS_URI=
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
REDIS_CACHE_URL=redis://127.0.0.1:6379/4

# Set false locally to exercise the real queue (see config/settings/dev.py).
CELERY_TASK_ALWAYS_EAGER=true

# --- limits ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
# Search costs money per call (it embeds the query), so keep this tight.
THROTTLE_SEARCH=30/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_CONTACT=5/hour
THROTTLE_WRITE=60/hour
THROTTLE_READ=300/min

# --- email (prod) ---------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

LOG_LEVEL=INFO
